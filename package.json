{
  "name": "monkey-lang",
  "version": "1.0.0",
  "description": "Monkey programming language interpreter and compiler",
  "scripts": {
    "dev": "RUST_LOG=debug cargo run",
    "start": "cargo run --release",
    "start:go": "cd go && go run main.go",
    "test": "cargo test",
    "lint": "cargo clippy",
    "build": "cargo build",
    "build:release": "cargo build --release",
    "format": "cargo fmt && prettier --log-level silent --write .",
    "format:check": "cargo fmt --check && prettier --ignore-path .gitignore --check .",
    "clean": "cargo clean && rimraf node_modules",
    "clean:rs": "cargo clean",
    "clean:node": "rimraf node_modules",
    "precommit": "pnpm run format && pnpm run lint && pnpm run test",
    "prepare": "husky"
  },
  "author": "Harsh Thakur",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "lint-staged": {
    "*": "pnpm run precommit --"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}
